# NEXUS OS — copy to .env (never commit .env). All variables are optional; defaults are safe.

# Where runtime data lives (database, secrets file fallback, project workspaces).
# Default: the OS user-data directory (e.g. %APPDATA%\nexus-os, ~/.local/share/nexus-os).
# NEXUS_HOME=

# API bind address. NEXUS OS refuses non-loopback hosts unless NEXUS_ALLOW_NON_LOOPBACK=true.
# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=8765

# Bearer token required on every API call except /api/health/ping (min 16 chars).
# If unset, a random token is generated once and stored in NEXUS_HOME/api_token (mode 0600).
# scripts/dev.py generates a fresh one per launch and shares it with the Vite dev proxy.
# NEXUS_API_TOKEN=

# Extra allowed browser origins, as a JSON list.
# NEXUS_ALLOWED_ORIGINS=["http://localhost:5173"]

# NEXUS_LOG_LEVEL=INFO

# Provider API keys are NOT configured here. Add them in Settings -> AI Providers; they are stored
# in your OS keychain (or a private file when no keychain is available), never in .env or the database.
